import os
import sqlite3
from datetime import datetime, timedelta
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes
from keep_alive import keep_alive

TOKEN = os.environ.get('TELEGRAM_BOT_TOKEN')
ADMIN_ID = int(os.environ.get('ADMIN_ID', 0))
DB_NAME = os.path.join(os.path.dirname(__file__), 'vip.db')

def init_db():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS vip_users
                 (user_id INTEGER PRIMARY KEY, username TEXT, end_date TEXT)''')
    conn.commit()
    conn.close()

def is_vip(user_id):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT end_date FROM vip_users WHERE user_id =?", (user_id,))
    row = c.fetchone()
    conn.close()
    if row:
        end_date = datetime.strptime(row[0], '%Y-%m-%d')
        return end_date > datetime.now()
    return False

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if not is_vip(user_id) and user_id!= ADMIN_ID:
        await update.message.reply_text("Você não tem acesso ao VIP ainda 😢\nClique em COMO COMPRAR")
        return

    keyboard = [[InlineKeyboardButton("📋 MENU VIP", callback_data='menu')]]
    await update.message.reply_text("Oi amor 💋 Bem vinda ao meu VIP", reply_markup=InlineKeyboardMarkup(keyboard))

#... resto dos comandos igual, mas com verificação de ADMIN_ID no /add

def main():
    init_db()
    app = Application.builder().token(TOKEN).build()

    # Recarrega jobs ao iniciar
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT user_id, end_date FROM vip_users")
    for user_id, end_date_str in c.fetchall():
        end_date = datetime.strptime(end_date_str, '%Y-%m-%d')
        if end_date > datetime.now():
            app.job_queue.run_once(remove_vip, when=end_date, data=user_id)
            if end_date - timedelta(days=1) > datetime.now():
                app.job_queue.run_once(reminder, when=end_date - timedelta(days=1), data=user_id)
    conn.close()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("add", add_vip))
    app.add_handler(CallbackQueryHandler(button))
    keep_alive()
    app.run_polling()

if __name__ == '__main__':
    main()
